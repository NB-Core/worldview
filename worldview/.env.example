# Copy to .env and fill in. Never commit .env.

# FRED — get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA — get a free key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional: where the SQLite DB lives. Defaults to worldview/store/worldview.db.
WORLDVIEW_DB_PATH=

# Optional: override config dir (defaults to ./config)
WORLDVIEW_CONFIG_DIR=
